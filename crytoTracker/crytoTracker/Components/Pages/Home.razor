@page "/"
@using crytoTracker.Components.Blocks
@inject HttpClient client

<TokenSelector Tickers=@tickers/>

<div class="container">
    @foreach(string ticker in tickersName){
        <CurrencyVeiwer TickerSymbolConverted=@ticker></CurrencyVeiwer>
    }
</div>

<Graph/>

@code{
    public string[] tickers = [];
    List<string> tickersName = new List<string>();

    protected override async Task OnInitializedAsync()
    {
        tickers = await client.GetFromJsonAsync<string[]>("Cryptocurrency/tickers");
    }
}