@page "/"
@using crytoTracker.Components.Blocks
@inject HttpClient client
<TokenSelector Tickers="tickers" DisplayedTickers="strings"/>
<CurrencyViewerCollection tickersName="strings"></CurrencyViewerCollection>

<Graph/>

@code{
    List<string> strings = new List<string>() {};
    public string[] tickers = [];

    protected override async Task OnInitializedAsync()
    {
        tickers = await client.GetFromJsonAsync<string[]>("Cryptocurrency/tickers");
    }
}