@using System.Globalization;

<style>
    .graph{
    width:70%;
    aspect-ratio:3.2;
    background-color: #e2e8f0;
    position:relative;
    left: 50%;
    transform: translate(-50%);
    padding-top: 10px;
    padding-left: 3px;
    padding-right: 3px;
    align-items:end;

    display: grid;
    grid-template-columns:repeat(50,1fr);
    }

    .bar{
        background-color: #553C9A;
    }
</style>

<div class="graph">
    @for(int i =0; i<50; i++)
    {
        string s = $"height:{data[i].ToString(nfi)}%;";
        <div class="bar" style=@s></div>
    }
</div>
@code {

    List<float> data = FillWithRandomData();
    NumberFormatInfo nfi = new NumberFormatInfo { NumberDecimalSeparator = "." };

    private static List<float> FillWithRandomData()
    {
        Random random = new Random();
        List<float> list = new List<float>();
        for(int i = 0; i < 50; i++)
        {
            list.Add(random.Next(100) + (float)random.NextDouble());
        }

        return list;
    }
}
