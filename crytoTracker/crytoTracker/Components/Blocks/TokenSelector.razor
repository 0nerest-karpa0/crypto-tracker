<div class="token-selector">
    <input @oninput="TextChanged" type="text" placeholder="Введите название тикера" @on/>
    <div class="button-collection">
        @foreach(string ticker in top5Tickers)
        {
            <button class="ticker-name-button">@ticker</button>
        }
    </div>
    @if(showErrorText)
    {
        <label class="error-text">Такой тикер не найден</label>
    }
</div>

@code {
    [Parameter]
    public string[] Tickers { get; set; }

    [Parameter]
    public List<string> DisplayedTickers { get; set; }

    // [Parameter]
    // public EventCallback OnTickerSelected { get; set; }

    private List<string> filteredTickers = [];
    private string[] top5Tickers = [];
    private bool showErrorText;

    protected override void OnParametersSet()
    {
        top5Tickers = Tickers.Take(5).ToArray();
    }

    private void TextChanged(ChangeEventArgs e)
    {
        if (e.Value == null) 
        {
            top5Tickers = Tickers.Take(5).ToArray();
            return;
        }

        string filterString = ((string)e.Value).ToUpper();
        filteredTickers = [];
        foreach(string ticker in Tickers)
        {
            if(ticker.Contains(filterString))
            {
                filteredTickers.Add(ticker);
            }
        }

        top5Tickers = filteredTickers.Take(5).ToArray();

        showErrorText = top5Tickers.Length == 0;
    }
    private void OnTickerSelected(ChangeEventArgs e)
    {
        DisplayedTickers.Add(top5Tickers[0]);
    }
}
