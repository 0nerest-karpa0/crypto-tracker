<style>
    .token-selector {
    width: 70%;
    background-color: #e2e8f0;
    position: relative;
    left: 50%;
    transform: translate(-50%);
    padding-top: 10px;
    padding-left: 3px;
    padding-right: 3px;
    padding-bottom: 10px;
    font-family: Arial;
    }

    .token-selector > input {
    width: 20%;
    border-radius: 3.5px;
    border:none;
    }

    .ticker-name-button{
    border:none;
    background-color:white;
    border-radius:3.5px;
    margin:2px;
    padding:1px;
    padding-left:5px;
    padding-right:5px;
    }

    .button-collection{
    margin-top:10px;
    margin-bottom:10px;
    }

    .error-text{
    color:red;
    }
</style>

<div class="token-selector">
    <input @oninput= "TextChanged" @onselect= "TickerEntered" type="text" placeholder="Введите название тикера"/>
    <div class="button-collection">
        @foreach(string ticker in top5Tickers)
        {
            <button class="ticker-name-button">@ticker</button>
        }
    </div>
    @if(showErrorText)
    {
        <label class="error-text">Такой тикер не найден</label>
    }
</div>

@code {
    [Parameter]
    public string[] Tickers { get; set; }

    private List<string> filteredTickers = [];
    private string[] top5Tickers = [];
    private bool showErrorText;

    protected override void OnParametersSet()
    {
        top5Tickers = Tickers.Take(5).ToArray();
    }

    private void TextChanged(ChangeEventArgs e)
    {
        if (e.Value == null) 
        {
            top5Tickers = Tickers.Take(5).ToArray();
            return;
        }

        string filterString = ((string)e.Value).ToUpper();
        filteredTickers = [];
        foreach(string ticker in Tickers)
        {
            if(ticker.Contains(filterString))
            {
                filteredTickers.Add(ticker);
            }
        }

        top5Tickers = filteredTickers.Take(5).ToArray();

        showErrorText = top5Tickers.Length == 0;
    }

    private void TickerEntered()
    {
        string ticker = top5Tickers[0];
    }
}
