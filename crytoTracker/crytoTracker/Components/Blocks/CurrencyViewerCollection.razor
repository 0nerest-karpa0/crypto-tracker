<style>
    .currency-viewer-container {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        position: relative;
        background-color: #e2e8f0;
        width: 70%;
        left: 50%;
        transform: translate(-50%);
        padding-top: 10px;
        padding-left: 3px;
        padding-right: 3px;
    }

</style>

<div class="currency-viewer-container">
    @foreach (string ticker in tickersName)
    {
        <CurrencyViewer Ticker="@ticker"></CurrencyViewer>
    }
</div>
@code {
    [Parameter]
    public List<string> tickersName { get; set; } = [];

    public void AddTicker(string tickerName)
    {
        tickersName.Add(tickerName);
    }
}
