<style>
    .currency-viewer {
        background-color:white;
        /* width: 21%; */
        aspect-ratio: 2.15;
        border-radius: 10px;
        margin-bottom:5px;
        margin-right:5px;
        font-family:Arial;
        /* font-size: 0.875rem; */
        text-align:center;
        /* padding-top:3px; */
    }

    .value{
        color: #1a202c;
        font-size: 1.875rem;

    }

    .upper-text{
        color: #1a202c;
        font-size: 0.875rem;
    }
</style>

<div class="currency-viewer">
    <label class="upper-text">@TickerSymbolOriginal – @TickerSymbolConverted</label>
    <label class="value">0.0</label>
</div>

@code {
    [Parameter]
    public string TickerSymbolOriginal { get; set; } = "";

    [Parameter]
    public string TickerSymbolConverted { get; set; } = "";


    bool isSelected = false;

    private void OnClick(){
        isSelected = !isSelected;
    }
}
